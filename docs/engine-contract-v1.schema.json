{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema.local/schemas/engine-contract-v1.schema.json",
  "title": "NOEMA Engine contract 1.0",
  "description": "Generated by cpu_platform.contract.json_schema(); do not edit by hand. Cross-field rules are documented in docs/engine-contract.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/EngineRequest"
    },
    {
      "$ref": "#/$defs/EngineResult"
    }
  ],
  "$defs": {
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "default": 1024
        },
        "max_wall_seconds": {
          "type": "number",
          "maximum": 86400,
          "exclusiveMinimum": 0,
          "default": 600.0
        }
      },
      "required": []
    },
    "CheckedClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "result": {
          "enum": [
            "verified",
            "refuted"
          ]
        },
        "checker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "named checker, e.g. 'exact_arithmetic'"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "exactly what the check establishes"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "claim",
        "result",
        "checker",
        "scope",
        "evidence_ids"
      ]
    },
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "model_wall_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 0.0
        },
        "total_wall_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 0.0
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "null = not measured (must be in not_run)",
          "default": null
        },
        "peak_rss_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "null = not measured (must be in not_run)",
          "default": null
        }
      },
      "required": []
    },
    "EngineRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "task": {
          "enum": [
            "ask",
            "repo_ask",
            "repo_fix"
          ],
          "description": "ask: no repository; repo_ask: grounded Q&A (M2.3); repo_fix: propose and test a patch (M3)",
          "default": "ask"
        },
        "contract_version": {
          "enum": [
            "1.0"
          ],
          "default": "1.0"
        },
        "repo": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "allow_execution": {
          "type": "boolean",
          "description": "permit sandboxed execution (repo_fix only)",
          "default": false
        },
        "thinking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = the model adapter's default",
          "default": null
        },
        "client_request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "question"
      ]
    },
    "EngineResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "task": {
          "enum": [
            "ask",
            "repo_ask",
            "repo_fix"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "incomplete",
            "error"
          ],
          "description": "ok: an answer was produced (it may still be unverified); incomplete: no usable answer within budget; error: see 'error'"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contract_version": {
          "enum": [
            "1.0"
          ],
          "default": "1.0"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checked_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckedClaim"
          }
        },
        "unverified_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnverifiedClaim"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutionRecord"
          }
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "not_run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotRun"
          }
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id",
        "task",
        "status",
        "engine_version"
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "kind": {
          "enum": [
            "input",
            "model_output",
            "file_span",
            "command_output"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "where it came from: 'question', a repo-relative path, an execution id"
        },
        "start_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA256 of the full span text",
          "default": null
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_by": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "description": "retriever or step that produced it",
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "source"
      ]
    },
    "ExecutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "sandbox backend that ran it, e.g. 'dev', 'container'"
        },
        "security_boundary": {
          "type": "boolean",
          "description": "true only for a backend that isolates the host; 'dev' never does"
        },
        "network": {
          "type": "boolean"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when killed or not started"
        },
        "timed_out": {
          "type": "boolean"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "stdout_tail": {
          "type": "string",
          "maxLength": 16000,
          "default": ""
        },
        "stderr_tail": {
          "type": "string",
          "maxLength": 16000,
          "default": ""
        },
        "output_truncated": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "command",
        "backend",
        "security_boundary",
        "network",
        "exit_code",
        "timed_out",
        "duration_s"
      ]
    },
    "ModelInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ]
    },
    "NotRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "item",
        "reason"
      ]
    },
    "RepoRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "local repository root"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "description": "commit, branch or tag; null = working tree",
          "default": null
        }
      },
      "required": [
        "path"
      ]
    },
    "UnverifiedClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "why it was not checked"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "claim",
        "reason"
      ]
    }
  }
}
